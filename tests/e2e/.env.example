# End-to-end test configuration. Copy to .env (git-ignored) and fill as needed.

# Target Upload Function. Defaults to the deployed QA function if unset.
E2E_UPLOAD_FUNCTION_URL=https://artnet-qa-upload-function-566327068481.us-east4.run.app

# Cloudflare Access service token for the SSO-gated read path
# (artworks.artnet-dev.com). Read-path tests skip when these are unset.
# Create one in Cloudflare Zero Trust > Access > Service Auth, then authorize the
# token on the artworks Access application.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
